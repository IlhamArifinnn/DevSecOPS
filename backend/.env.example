PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=db_ecommerce

# Redis WAJIB pakai password (mitigasi Info Disclosure, PRD Section 7)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=ganti_password_redis

JWT_SECRET=ganti_dengan_random_64_char

# Email: default Mailpit Laragon (UI http://localhost:8025)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Toko Online <no-reply@toko.local>"

# Midtrans sandbox. PAYMENT_MOCK=true = tanpa panggil Snap, pakai `npm run webhook` untuk simulasi
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxx
MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com
PAYMENT_MOCK=true

ADMIN_EMAIL=admin@toko.local
ADMIN_PASSWORD=ganti_password_admin
